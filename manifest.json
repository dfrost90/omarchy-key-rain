{
  "schemaVersion": 1,
  "id": "io.github.dfrost90.falling-keys",
  "name": "Key Rain",
  "version": "0.7.4",
  "author": "dfrost90",
  "description": "Click-through falling keystrokes with a layout control panel.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Key Rain",
    "category": "Appearance",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "layout": "matrix",
      "followTheme": false,
      "splitMode": false,
      "fontSize": 22,
      "opacityPercent": 100,
      "fallHeightPercent": 100,
      "customColor": "#36e568",
      "colorMode": "",
      "scrambleOnEntry": true
    },
    "schema": [
      {
        "key": "layout",
        "type": "string",
        "label": "Animation layout"
      },
      {
        "key": "splitMode",
        "type": "boolean",
        "label": "Split keyboard"
      },
      {
        "key": "fontSize",
        "type": "number",
        "label": "Glyph font size (16, 22, or 30 px)"
      },
      {
        "key": "opacityPercent",
        "type": "number",
        "label": "Opacity (10–100%)"
      },
      {
        "key": "fallHeightPercent",
        "type": "number",
        "label": "Fall height (10–100% of screen)"
      },
      {
        "key": "colorMode",
        "type": "string",
        "label": "Color mode (theme, matrix, custom)"
      },
      {
        "key": "customColor",
        "type": "string",
        "label": "Custom color (#RRGGBB)"
      },
      {
        "key": "scrambleDurationMs",
        "type": "number",
        "label": "Scramble duration (0–1000 ms; 0 disables)"
      }
    ]
  },
  "license": "MIT"
}
